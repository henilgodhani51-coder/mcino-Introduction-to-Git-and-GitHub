    ")\n",
    "plt.xlabel('Unemployment Rate')\n",
    "plt.ylabel('Automobile Sales')\n",
    "plt.title('Effect of Unemployment Rate on Vehicle Type and Sales During Recession')\n",
    "plt.legend(title='Vehicle Type')\n",
    "plt.show()"
   ]
  }
